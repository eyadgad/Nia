# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database (supply credentials locally; never commit populated values) ---
POSTGRES_DB=nia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
ASSISTANT_RUNTIME_PASSWORD=
ASSISTANT_MIGRATOR_PASSWORD=
ASSISTANT_DATABASE_URL=
ASSISTANT_MIGRATOR_DATABASE_URL=
ASSISTANT_SCHEMA=assistant
ASSISTANT_API_SCHEMA=assistant_api
APPLY_APP_STUBS=true

# --- Auth (standalone Phase 1) ---
AUTH_ADAPTER=standalone
JWT_SECRET=
JWT_ISSUER=nia-standalone
JWT_TTL_SECONDS=43200
AUTH_COOKIE_NAME=nia_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
STANDALONE_DEMO_USERNAME=
STANDALONE_DEMO_PASSWORD=
STANDALONE_DEMO_PRINCIPAL_ID=
STANDALONE_DEMO_ALLOWED_FILE_IDS=49,91,93,94
STANDALONE_DEMO_CAN_USE_PRIVATE_FILES=true
STANDALONE_DEMO_HISTORY_ALLOWED=false

# Optional voice_cli overrides. Blank values fall back to the standalone
# researcher settings above. Prefer environment variables over --password.
NIA_CLI_USER=
NIA_CLI_PASSWORD=
NIA_CLI_PRINCIPAL=

# Website mode validates a minimal signed AccessScope token from the existing
# NIA website. Use different values from JWT_SECRET/JWT_ISSUER.
WEBSITE_JWT_SECRET=
WEBSITE_JWT_ISSUER=nia-website
WEBSITE_JWT_AUDIENCE=nia-assistant

# --- Product policy ---
DEFAULT_PEOPLE_FILE_ID=49
ENABLE_HISTORY_QUERIES=false
ENABLE_ATTACHMENT_CONTENT=false

# --- LiveKit (Phase C) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HEALTH_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- xAI (Phase B/C) ---
# Required on the backend process. Without this key, AI-mode planning and
# review cannot run (legacy deterministic paths still work). Voice CLI talks
# to /api/assistant.
XAI_API_KEY=
# The Cloudflare bridge speaks the same API as xAI over REST. `xai` still selects the
# gRPC SDK path and remains a one-variable rollback.
REASONING_PROVIDER=http
REASONING_BASE_URL=
REASONING_MODEL=grok-4.20-0309-non-reasoning

# --- Planner (Phase 2: AI default, legacy emergency rollback) ---
PLANNER_MODE=ai
PLANNER_MIN_CONFIDENCE=0.75
PLANNER_REQUIREMENT_CHECK=true
PLANNER_SELF_REVIEW=true
# always | off. conditional and shadow are not implemented and will fail settings load.
PLANNER_REVIEW_MODE=always
# Planning stays on the fast non-reasoning model even if the UI picks another.
PLANNER_MODEL=grok-4.20-0309-non-reasoning
PLANNER_REVIEW_MODEL=
TTS_PROVIDER=xai
XAI_TTS_VOICE=rex
XAI_TTS_MALE_VOICE=rex
XAI_TTS_FEMALE_VOICE=ara
XAI_TTS_LANGUAGE=en
XAI_TTS_FORMAT=pcm
XAI_TTS_STREAMING=true

# --- Whisper (Phase C) ---
WHISPER_MODEL=small.en
WHISPER_INITIAL_PROMPT=Nia is a research assistant. The name Nia may be spelled N I A. Users may spell names and words one letter at a time.
WHISPER_HOTWORDS=Nia, N I A, hi, hello, hey
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
WHISPER_SERVICE_URL=http://localhost:8090

# --- Optional ---
REDIS_URL=
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=am_adam
KOKORO_MALE_VOICE=am_adam
KOKORO_FEMALE_VOICE=af_heart
KOKORO_FORMAT=pcm

# --- Budgets / concurrency ---
MAX_EVIDENCE_TOKENS=3000
MAX_RETRIEVAL_RESULTS=12
RECENT_TURN_COUNT=6
RESULT_SET_RETENTION_HOURS=72
QUERY_TRACE_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=90
CONVERSATION_RETENTION_DAYS=0
QUERY_DAG_MAX_CONCURRENCY=8
RETRIEVAL_MAX_CONCURRENCY=6
DB_POOL_MIN=2
DB_POOL_MAX=12
DB_QUERY_CONCURRENCY=8
DB_QUERY_TIMEOUT_MS=2000
MODEL_MAX_CONCURRENCY_PER_TURN=2
MODEL_MAX_CONCURRENCY_GLOBAL=16
TTS_QUEUE_MAX_PHRASES=8
WHISPER_MAX_CONCURRENT_SESSIONS=4
BACKGROUND_WORKER_CONCURRENCY=4
RETRIEVAL_BRANCH_TIMEOUT_MS=1500
XAI_REQUEST_TIMEOUT_MS=15000
# Planning is structured extraction against a schema, not writing, so it does not sample.
# MODEL_SEED is unset because it does not buy reproducibility on this provider -- measured,
# a fixed seed still let the same question compile to different plans. Set it only to pin a
# specific replay.
MODEL_TEMPERATURE=0.0
# MODEL_SEED=
# A name that matches nothing is checked against the recorded name index by edit distance.
# One edit away and unambiguous is corrected in place and the correction is stated; anything
# further out is put back to the researcher as a question.
NAME_CORRECTION=true
NAME_CORRECTION_MAX_DISTANCE=2
NAME_CORRECTION_LIMIT=6
XAI_TTS_FIRST_AUDIO_TIMEOUT_MS=4000
READINESS_TIMEOUT_MS=1500

# --- Per-process abuse protection ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_MINUTE=60
LIVEKIT_RATE_LIMIT_PER_MINUTE=20
TTS_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
